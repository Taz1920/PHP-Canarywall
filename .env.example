# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Admin key for the dashboard and API (/__sentinel/dashboard).
# If not set, a random key is generated and printed to container logs on startup.
SENTINEL_ADMIN_KEY=change-me

# Your PHP application's internal Docker address.
SENTINEL_BACKEND_URL=http://backend:80

# Block requests containing PHP_SESSION_UPLOAD_PROGRESS (CVE-2026-109618/109619 vector).
SENTINEL_BLOCK_UPLOAD_PROGRESS=true

# Shadow mode: log what would be blocked without actually blocking.
SENTINEL_SHADOW_MODE=false

# Test mode: enable simulated kill/OOM/timeout endpoints in canaries (for kill_test.py).
SENTINEL_TEST_MODE=0
